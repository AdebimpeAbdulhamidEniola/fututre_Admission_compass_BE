PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the frontend's dev server / deployed URL)
CORS_ORIGIN=http://localhost:5173

# Stage 1 — data layer (Postgres via Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placeright?schema=public

# Stage 2 — auth. Generate a real value, e.g. `openssl rand -hex 32` — never commit a real secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
