// PlaceRight backend — Stage 1 data layer.
// Mirrors src/types/domain.ts in the frontend repo (future-admissions-compass) 1:1 wherever possible.
// See docs/backend-implementation-plan.md and docs/jamb-data-dossier.md in that repo for the full spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  ADMIN
}

enum OLevelGrade {
  A1
  B2
  B3
  C4
  C5
  C6
  D7
  E8
  F9
}

enum EvaluationModule {
  VERIFICATION
  SCORING
  CATCHMENT
  RECOMMENDATION
}

enum EvaluationOutcome {
  SUCCESS
  FAILURE
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CANDIDATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidateProfile CandidateProfile?
  adminLogEntries  AdminLogEntry[]

  @@map("users")
}

model University {
  id           String @id @default(cuid())
  code         String @unique // "UI" | "UNILAG" | "OAU" | "FUTA" | "FUNAAB" | "FUOYE"
  name         String
  locationState String

  courses        Course[]
  scoringPolicy  ScoringPolicy?
  catchmentRule  CatchmentRule?

  @@map("universities")
}

model Course {
  id               String @id @default(cuid())
  universityId     String
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name             String
  faculty          String

  /// Nullable because the dossier (docs/jamb-data-dossier.md) genuinely has no confirmed figure
  /// for some courses (e.g. FUTA Chemical Engineering, several FUTA "estimate only" rows) — null
  /// means "not yet known," never a guessed value. Also null for FUTA/FUNAAB/FUOYE courses whose
  /// only published figure is on a scale (raw 0-400 JAMB, or an "estimated JAMB score") that isn't
  /// comparable to the 0-100 aggregate computeAggregate() produces — see the seed script's
  /// SCALE NOTE for exactly which universities/courses this affects and why.
  meritCutOff      Float?
  catchmentCutOff  Float?
  eldsCutOff       Float?

  /// Per-catchment-state cut-off overrides, e.g. { "Lagos": 73, "Ogun": 76 }.
  /// Falls back to catchmentCutOff for any state not present here.
  /// See the dossier's UNILAG/OAU sections — this is a real published pattern, not a hypothetical.
  catchmentCutOffByState Json?

  /// Same idea as catchmentCutOffByState, but for ELDS (only OAU publishes this so far).
  eldsCutOffByState Json?

  /// Raw JAMB/UTME cut-off (0–400), for courses whose university publishes only that and no 0–100
  /// aggregate cut-off — every FUNAAB course (Confirmed, FUNAAB's 2026/27 admission portal). Used
  /// only when the 0–100 cut-off for the candidate's status is null: the candidate's UTME score is
  /// then compared against it instead of their aggregate.
  utmeCutOff Int?

  requirement     AdmissionRequirement?
  assessments     AssessmentReport[]
  recommendations Recommendation[]

  @@unique([universityId, name])
  @@map("courses")
}

model AdmissionRequirement {
  id                     String   @id @default(cuid())
  courseId               String   @unique
  course                 Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requiredUtmeSubjects   String[]
  optionalUtmeSubjects   String[]
  requiredOLevelSubjects String[]
  minimumCredits         Int

  /// Subjects that may stand in for a required O'Level subject, e.g.
  /// [{ "subject": "Biology", "alternatives": ["Agricultural Science"], "countsTowardPoints": false }].
  /// A credit in an alternative satisfies the requirement for eligibility; countsTowardPoints says
  /// whether that alternative's grade is also scored. FUNAAB accepts Agriculture in lieu of Biology
  /// but scores it as zero (Confirmed, helpdesk.funaab.edu.ng Article ID 30); FUTA's Sciences and
  /// Agriculture schools accept Biology or Agricultural Science interchangeably (Likely).
  oLevelSubstitutions    Json     @default("[]")

  @@map("admission_requirements")
}

model ScoringPolicy {
  id               String     @id @default(cuid())
  universityId     String     @unique
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  utmeWeighting    Float
  postUtmeWeighting Float
  oLevelWeighting  Float
  utmeMaxScore     Float
  postUtmeMaxScore Float

  /// Per-university O'Level grade -> points table, e.g. { "A1": 6, "B2": 5, ... "F9": 0 }.
  /// Null means "use the engine's generic table" (A1=10..C6=5). FUNAAB's table is Confirmed
  /// (helpdesk.funaab.edu.ng Article ID 30); FUOYE's (A1=6..C6=1) is Likely, from
  /// docs/jamb-data-dossier.md. Both differ from the generic max of 50 (FUNAAB/FUOYE max 30) —
  /// the engine normalizes by this table's own max, so a smaller max still maps onto the same
  /// 0-100 percent scale correctly.
  oLevelGradePoints Json?

  /// Minimum Post-UTME percent (of postUtmeMaxScore) below which a candidate is disqualified
  /// outright, regardless of JAMB score — null means no such floor. UNILAG's is Likely 12% (see
  /// docs/jamb-data-dossier.md, UNILAG section). Checked in verifyEligibility(), not
  /// computeAggregate() — it's an eligibility gate, not a scoring adjustment.
  minPostUtmePercent Float?

  /// O'Level points deducted when a candidate combines two sittings (e.g. WAEC + NECO) — the best
  /// grade per subject is taken first, then this many points come off the total. Null means no
  /// deduction. FUNAAB's is 1 (Confirmed, helpdesk.funaab.edu.ng Article ID 30).
  twoSittingDeductionPoints Float?

  /// Points added straight onto the aggregate for the number of O'Level sittings, e.g.
  /// { "oneSitting": 10, "twoSittings": 6 }. Null means no such component. FUOYE's is Likely
  /// (docs/jamb-data-dossier.md). oneSitting counts toward the weightings' 100% total.
  sittingBonus Json?

  @@map("scoring_policies")
}

model CatchmentRule {
  id                    String     @id @default(cuid())
  universityId          String     @unique
  university            University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  catchmentStates       String[]
  eldsStates            String[]
  meritQuotaPercent     Float
  catchmentQuotaPercent Float
  eldsQuotaPercent      Float

  @@map("catchment_rules")
}

model CandidateProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  stateOfOrigin       String
  lga                 String
  schoolLocationState String
  utmeScore           Int
  postUtmeScore       Int?
  utmeSubjects        String[]
  /// How many O'Level sittings (exam results) the candidate combined: 1 or 2.
  oLevelSittings      Int      @default(1)
  targetCourseId      String?
  targetUniversityId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  oLevelResults   OLevelResult[]
  assessments     AssessmentReport[]
  recommendations Recommendation[]

  @@map("candidate_profiles")
}

model OLevelResult {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  subject            String
  grade              OLevelGrade

  @@map("olevel_results")
}

/// Stores the full VerificationResult / AggregateScoreResult / CatchmentResult / CourseRecommendation[] /
/// AssessmentContext JSON blobs alongside a few indexed columns for querying — those four result shapes
/// are read-mostly, candidate-specific, and never queried by their internal fields, so JSON keeps this
/// model simple instead of another five tables of columns that mirror the frontend's TS shapes exactly.
model AssessmentReport {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id])
  createdAt          DateTime         @default(now())

  verification    Json // VerificationResult
  score           Json? // AggregateScoreResult | null
  catchment       Json // CatchmentResult
  recommendations Json // CourseRecommendation[]
  context         Json // AssessmentContext

  recommendationRows Recommendation[]

  @@index([candidateProfileId])
  @@map("assessment_reports")
}

/// One alternative course the ML Decision Tree recommended to a candidate (thesis ERD:
/// RECOMMENDATION — CandidateID, SuggestedCourseID, MatchProbability). Also kept inside
/// AssessmentReport.recommendations as JSON for the results page; these rows are for querying.
model Recommendation {
  id                 String            @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  /// Null when the recommendation came from POST /recommendations rather than a saved assessment.
  assessmentReportId String?
  assessmentReport   AssessmentReport? @relation(fields: [assessmentReportId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rank               Int
  matchProbability   Float
  lowConfidence      Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@index([candidateProfileId])
  @@map("recommendations")
}

model AdminLogEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  summary   String

  @@map("admin_log_entries")
}

model EvaluationEvent {
  id            String            @id @default(cuid())
  timestamp     DateTime          @default(now())
  candidateId   String
  module        EvaluationModule
  outcome       EvaluationOutcome
  latencyMs     Int

  @@index([module, outcome])
  @@index([timestamp])
  @@map("evaluation_events")
}
